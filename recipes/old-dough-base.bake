# Get the old-dough ball rolling

starter:
  bread_flour
  water
  hydration = 100%

dough:
  whole_wheat 
  cold_water
  starter = 10g
  hydration = 70%
  total = 110g

/*
August 14, 2026

I forgot to remove the old dough from the last loaf so I'm going to
fake a small one.

Mixed about 15:40.

*/

