# Pandesal 
# https://www.pinoycookingrecipes.com/recipe/extra-soft-pandesal

dry:
  ap_flour = 435g
  sugar = 40g
  salt = 6g
  yeast = 7g
  nido = 15g

wet:
  egg = 50g
  evap_milk = 252g
  butter = 42g # melted
  water

dough:
  wet
  dry
  hydration = 65%

/*
2 August 2026

Changes
- Reduced hydration to 65%
- Used the KA

Next time
- Reduce the hydration to 55%

Using the mixer. Started about 12:45

I added about 50g of flour it was still sticky.

They were easy to handle with the additional flour. The crumbs
didn't stick very well. 

I've got to work on shaping.

*/

