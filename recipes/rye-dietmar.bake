# from https://www.homebaking.at/100-roggenlaib/

# Type 960 = 65% white, 35% whole

# he says this is 1800g TDW but I get only 1745g

starter:
  rye_flour
  water
  hydration = 100%

basic_sour:
  starter = 0.05 * rye
  water
  rye = 13% # 960
  hydration = 50%
# TA 150, TT 25-28C RZ 15-24 hours

full_sour:
  basic_sour
  water
  rye = 26% 
  hydration = 100%
# TA 200, TT 30C, RZ 3 hours

dough:
  full_sour
  rye
  water
  salt = 2%
  yeast = 0.6%

  total_flour = 983g
  hydration = 75%

