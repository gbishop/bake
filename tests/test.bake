# Simple test loaf

starter ^ 5%:
  ww_flour
  water
  hydration = 100%

dough:
  starter = 10g
  prairie_gold = 50%
  bronze_chief
  water
  yeast = 0.4%
  hydration = 70%
  total_flour = 400g
  salt = 2%
  # total = 793g

